{
  "version": 2,
  "routes": [
    { "src": "/proxy", "dest": "/api/proxy.js" },
    { "src": "/p", "dest": "/api/proxy.js" },
    { "src": "/go(.*)", "dest": "/api/go.js" },
    { "src": "/api/go(.*)", "dest": "/api/go.js" },
    { "src": "/api/edge-test", "dest": "/api/edge-test.js" },
    { "src": "/api/edge-proxy", "dest": "/api/edge-proxy.js" },
    { "src": "/playlist-edge\\.m3u8?", "dest": "/api/playlist-edge.js" },
    { "src": "/api/proxy", "dest": "/api/proxy.js" },
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/playlist\\.m3u8?", "dest": "/api/index.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
